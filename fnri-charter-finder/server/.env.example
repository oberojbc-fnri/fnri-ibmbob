# Server environment variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.

# ── Ollama (local, free) ──────────────────────────────────────────────────────
# Ollama must be running: `ollama serve`
# Pull a model first:     `ollama pull llama3.1`
#
# Supported models (ordered by quality vs. speed):
#   llama3.1        — best balance, ~5 GB, recommended
#   llama3.1:70b    — highest quality, needs 40+ GB RAM / good GPU
#   mistral         — fast, good JSON output, ~4 GB
#   phi3            — very fast, smaller, less accurate on long PDFs
#   gemma2          — Google's model, good at structured output

OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# ── Express server ────────────────────────────────────────────────────────────
PORT=3000
